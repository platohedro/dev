# Wompi Colombia. Usa valores pub_test_/test_integrity_/test_events_ en desarrollo.
# No publiques secretos ni los agregues al repositorio.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Dominio público sin barra final. Para desarrollo puede ser http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ambiente de ejecución. Valores: local, staging o production.
NEXT_PUBLIC_APP_ENV=local

# Supabase: usa la URL y la Publishable key del proyecto correspondiente.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
